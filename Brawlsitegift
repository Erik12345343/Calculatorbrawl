<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Brawl Stars - Калькулятор Прогресса</title>
    <style>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: 'Arial Black', sans-serif;
        }

        body {
            background: #0d0e15;
            color: #fff;
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 100vh;
            padding: 20px;
            overflow-x: hidden;
        }

        /* --- КИНО-ИНТРО ЭФФЕКТ --- */
        #intro-overlay {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background-color: #050508;
            display: flex;
            justify-content: center;
            align-items: center;
            z-index: 9999;
            opacity: 1;
            transition: opacity 1.2s ease-in-out, visibility 1.2s;
        }

        .intro-text {
            color: #ffcc00;
            font-size: 32px;
            text-transform: uppercase;
            letter-spacing: 4px;
            text-align: center;
            text-shadow: 0 0 20px rgba(255, 204, 0, 0.8), 0 0 40px rgba(255, 204, 0, 0.4);
            animation: cinematicZoom 3.2s ease-in-out forwards;
        }

        @keyframes cinematicZoom {
            0% {
                opacity: 0;
                transform: scale(0.7);
                filter: blur(10px);
            }
            30% {
                opacity: 1;
                filter: blur(0px);
            }
            70% {
                opacity: 1;
                transform: scale(1.1);
                filter: blur(0px);
            }
            100% {
                opacity: 0;
                transform: scale(1.25);
                filter: blur(6px);
            }
        }

        /* --- ОСНОВНОЙ ИНТЕРФЕЙС --- */
        .calculator-card {
            background: linear-gradient(145deg, #1b1c2b, #11121e);
            border: 4px solid #ffcc00;
            border-radius: 24px;
            padding: 30px;
            max-width: 480px;
            width: 100%;
            box-shadow: 0 0 30px rgba(255, 204, 0, 0.25);
            opacity: 0;
            transform: translateY(20px);
            transition: opacity 1s ease-out, transform 1s ease-out;
        }

        .calculator-card.visible {
            opacity: 1;
            transform: translateY(0);
        }

        h1 {
            color: #ffcc00;
            font-size: 24px;
            text-transform: uppercase;
            text-align: center;
            text-shadow: 2px 2px 0 #000;
            margin-bottom: 8px;
        }

        .subtitle {
            color: #8f94b2;
            font-size: 13px;
            text-align: center;
            margin-bottom: 25px;
            font-weight: normal;
        }

        .input-group {
            margin-bottom: 18px;
        }

        label {
            display: block;
            color: #ffcc00;
            font-size: 12px;
            text-transform: uppercase;
            margin-bottom: 6px;
        }

        input, select {
            width: 100%;
            padding: 12px;
            border-radius: 10px;
            border: 2px solid #2d3047;
            background: #151622;
            color: #fff;
            font-size: 16px;
            outline: none;
        }

        input:focus, select:focus {
            border-color: #ffcc00;
        }

        .results {
            background: #0b0c12;
            border: 2px dashed #ffcc00;
            border-radius: 16px;
            padding: 20px;
            margin-top: 25px;
        }

        .result-item {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 12px;
            font-size: 15px;
        }

        .result-item:last-child {
            margin-bottom: 0;
        }

        .value {
            color: #ffcc00;
            font-size: 18px;
            font-weight: bold;
        }

        .highlight {
            color: #00ff88;
        }

        .footer-tag {
            text-align: center;
            margin-top: 20px;
            font-size: 12px;
            color: #5d617a;
            font-weight: normal;
        }
    </style>
</head>
<body>

<!-- Экран Интро -->
<div id="intro-overlay">
    <div class="intro-text">W1full Presents</div>
</div>

<!-- Карточка сайта -->
<div class="calculator-card" id="mainCard">
    <h1>Brawl Upgrade Calc</h1>
    <p class="subtitle">Подарок покупателю: рассчитай ресурсы для прокачки аккаунта</p>

    <div class="input-group">
        <label>Сколько бойцов нужно прокачать? (1 - 105)</label>
        <input type="number" id="brawlersCount" value="1" min="1" max="105">
    </div>

    <div class="input-group">
        <label>Текущий уровень бойца(ов):</label>
        <select id="currentLevel">
            <option value="1">1 Уровень</option>
            <option value="2">2 Уровень</option>
            <option value="3">3 Уровень</option>
            <option value="4">4 Уровень</option>
            <option value="5">5 Уровень</option>
            <option value="6">6 Уровень</option>
            <option value="7">7 Уровень</option>
            <option value="8">8 Уровень</option>
            <option value="9">9 Уровень</option>
            <option value="10">10 Уровень</option>
        </select>
    </div>

    <div class="input-group">
        <label>Желаемый уровень:</label>
        <select id="targetLevel">
            <option value="11" selected>11 Уровень (MAX)</option>
            <option value="10">10 Уровень</option>
            <option value="9">9 Уровень</option>
            <option value="8">8 Уровень</option>
            <option value="7">7 Уровень</option>
            <option value="6">6 Уровень</option>
            <option value="5">5 Уровень</option>
            <option value="4">4 Уровень</option>
            <option value="3">3 Уровень</option>
            <option value="2">2 Уровень</option>
        </select>
    </div>

    <div class="results">
        <div class="result-item">
            <span>Нужно Золота (Coins):</span>
            <span class="value" id="coinsResult">7,765 🪙</span>
        </div>
        <div class="result-item">
            <span>Очков Силы (Power Points):</span>
            <span class="value" id="ppResult">3,780 ⚡</span>
        </div>
        <div class="result-item">
            <span>Примерно дней игры:</span>
            <span class="value highlight" id="daysResult">~ 13 дн.</span>
        </div>
    </div>

    <div class="footer-tag">Спасибо за покупку аккаунта! Приятной игры!</div>
</div>

<script>
    window.addEventListener('DOMContentLoaded', () => {
        const overlay = document.getElementById('intro-overlay');
        const mainCard = document.getElementById('mainCard');

        setTimeout(() => {
            overlay.style.opacity = '0';
            overlay.style.visibility = 'hidden';
            mainCard.classList.add('visible');
        }, 3200);
    });

    const cumulativeCosts = {
        1:  { coins: 0,     pp: 0 },
        2:  { coins: 20,    pp: 20 },
        3:  { coins: 55,    pp: 50 },
        4:  { coins: 130,   pp: 100 },
        5:  { coins: 270,   pp: 180 },
        6:  { coins: 560,   pp: 310 },
        7:  { coins: 1040,  pp: 520 },
        8:  { coins: 1840,  pp: 860 },
        9:  { coins: 3090,  pp: 1450 },
        10: { coins: 4965,  pp: 2340 },
        11: { coins: 7765,  pp: 3780 }
    };

    const countInput = document.getElementById('brawlersCount');
    const currentSelect = document.getElementById('currentLevel');
    const targetSelect = document.getElementById('targetLevel');

    function calculate() {
        let count = parseInt(countInput.value) || 1;

        // Ограничение ввода от 1 до 105
        if (count > 105) {
            count = 105;
            countInput.value = 105;
        } else if (count < 1) {
            count = 1;
        }

        let cur = parseInt(currentSelect.value);
        let target = parseInt(targetSelect.value);

        if (target <= cur) {
            document.getElementById('coinsResult').innerText = "0 🪙";
            document.getElementById('ppResult').innerText = "0 ⚡";
            document.getElementById('daysResult').innerText = "Уже прокачан!";
            return;
        }

        let coinsNeeded = (cumulativeCosts[target].coins - cumulativeCosts[cur].coins) * count;
        let ppNeeded = (cumulativeCosts[target].pp - cumulativeCosts[cur].pp) * count;
        
        let approxDays = Math.ceil(coinsNeeded / 600);

        document.getElementById('coinsResult').innerText = coinsNeeded.toLocaleString() + " 🪙";
        document.getElementById('ppResult').innerText = ppNeeded.toLocaleString() + " ⚡";
        document.getElementById('daysResult').innerText = "~ " + approxDays + " дн.";
    }

    countInput.addEventListener('input', calculate);
    currentSelect.addEventListener('change', calculate);
    targetSelect.addEventListener('change', calculate);

    calculate();
</script>

</body>
</html>
